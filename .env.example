# Where your Sharkord server keeps its plugins. Set it and `bun run build`
# installs the plugin for you.
# development server: <sharkord repo>/apps/server/data/plugins
# installed server: ~/.config/sharkord/plugins
SHARKORD_PLUGINS_PATH=

# Only needed by `bun run publish`
GITHUB_TOKEN=
PLUGIN_REPOSITORY=EssekerDev/sharkord-rss
